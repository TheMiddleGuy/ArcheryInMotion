{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-msvc-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug (MSVC + CUDA)",
            "inherits": "windows-msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release (MSVC + CUDA)",
            "inherits": "windows-msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "x64-debug", "configurePreset": "x64-debug" },
        { "name": "x64-release", "configurePreset": "x64-release" }
    ],
    "testPresets": [
        { "name": "x64-debug", "configurePreset": "x64-debug", "output": { "outputOnFailure": true } },
        { "name": "x64-release", "configurePreset": "x64-release", "output": { "outputOnFailure": true } }
    ]
}
